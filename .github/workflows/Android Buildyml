mkdir -p .github/workflows
cat > .github/workflows/android.yml << 'EOF'
name: Build Android
on: workflow_dispatch
jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4

      - name: Android SDK e NDK r15c
        run: |
          export JAVA_HOME=$JAVA_HOME_17_X64
          yes | sdkmanager --licenses > /dev/null || true
          sdkmanager "platforms;android-29" "build-tools;29.0.3" "ndk;15.2.4203891"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 11

      - uses: krdlab/setup-haxe@v1
        with:
          haxe-version: 4.2.5

      - name: Libs do Haxe
        run: |
          haxelib setup ~/haxelib
          haxelib install lime 7.9.0
          haxelib install openfl 9.1.0
          haxelib install flixel 4.11.0
          haxelib install flixel-addons 2.11.0
          haxelib install flixel-ui 2.4.0
          haxelib install hscript 2.4.0
          haxelib install actuate
          haxelib install polymod
          haxelib git extension-webm https://github.com/KadeDev/extension-webm
          haxelib git linc_luajit https://github.com/nebulazorua/linc_luajit
          haxelib run lime setup -alias -y

      - name: Configurar Lime para Android
        run: |
          haxelib run lime config ANDROID_SDK $ANDROID_HOME
          haxelib run lime config ANDROID_NDK_ROOT $ANDROID_HOME/ndk/15.2.4203891
          haxelib run lime config JAVA_HOME $JAVA_HOME
          haxelib run lime config ANDROID_SETUP true

      - name: Compilar
        run: haxelib run lime build android -final -DHXCPP_ARM64

      - uses: actions/upload-artifact@v4
        with:
          name: KadeEngine-Android
          path: export/release/android/bin/app/build/outputs/apk/**/*.apk
EOF
